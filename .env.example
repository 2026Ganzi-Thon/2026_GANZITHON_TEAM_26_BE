# 사용법: 바꾸고 싶은 줄만 맨 앞의 # 을 지우고 값을 채운다.
# 주의: "KEY=" 처럼 값을 비운 채로 # 을 지우면 빈 값으로 덮어써져서 실행이 실패한다.

# ===== DB (MySQL) =====
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=hanol
# DB_USERNAME=hanol
# DB_PASSWORD=hanol

# ===== Redis =====
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ===== JWT =====
# 생성: openssl rand -base64 32
# JWT_SECRET=
# JWT_ACCESS_TOKEN_VALIDITY=
# JWT_REFRESH_TOKEN_VALIDITY=

# ===== 메일 (회원가입 이메일 인증) =====
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# ===== AI API (패치 검수) =====
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# ===== 기타 =====
# CORS_ALLOWED_ORIGINS=*
# SERVER_PORT=8080
