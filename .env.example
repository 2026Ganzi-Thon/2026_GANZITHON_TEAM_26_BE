# 이 파일을 복사해서 .env 를 만든다:  cp .env.example .env
# .env 는 .gitignore 에 들어 있어 커밋되지 않는다. 실제 값은 레포 밖(카톡/노션)으로 공유한다.
#
# 사용법: 바꾸고 싶은 줄만 맨 앞의 # 을 지우고 값을 채운다.
# 주의: "KEY=" 처럼 값을 비운 채로 # 을 지우면 빈 값으로 덮어써져서 실행이 실패한다.
# 로컬(local 프로필)은 아무것도 안 바꿔도 docker-compose.local.yml 기본값으로 실행된다.

# ===== DB (MySQL) =====
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=hanol
# DB_USERNAME=hanol
# DB_PASSWORD=hanol

# ===== Redis =====
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ===== JWT =====
# 생성: openssl rand -base64 32   (로컬은 기본 키가 있어서 안 넣어도 됨)
# JWT_SECRET=
# JWT_ACCESS_TOKEN_VALIDITY=1h
# JWT_REFRESH_TOKEN_VALIDITY=7d

# ===== 메일 (회원가입 이메일 인증) =====
# Gmail 사용 시 MAIL_PASSWORD 는 계정 비밀번호가 아니라 '앱 비밀번호'
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# ===== AI API (Upstage, 사연 위기 검사·패치 검수) =====
# AI_API_KEY=
# AI_BASE_URL=https://api.upstage.ai/v1
# AI_MODEL=solar-pro4

# ===== 기타 =====
# CORS_ALLOWED_ORIGINS=*
# SERVER_PORT=8080
