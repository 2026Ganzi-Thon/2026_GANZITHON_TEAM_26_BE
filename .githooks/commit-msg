#!/bin/sh
msg=$(head -1 "$1")

# 머지/리버트 커밋은 검사하지 않는다
if echo "$msg" | grep -qE "^(Merge|Revert) "; then
  exit 0
fi

if ! echo "$msg" | grep -qE "^(feat|fix|docs|style|refactor|test|chore|ci)(\(.+\))?!?: .+"; then
  echo "커밋 메시지가 컨벤션에 맞지 않습니다."
  echo ""
  echo " 형식: type(scope): 제목"
  echo " 예시: feat(auth): 로그인 API 추가"
  echo " 타입: feat|fix|docs|style|refactor|test|chore|ci"
  echo " 강조: type! 또는 type(scope)! 로 중요 변경 표시 가능"
  exit 1
fi